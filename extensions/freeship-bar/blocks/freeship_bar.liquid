{%- assign settings_json = shop.metafields.freeship.settings.value -%}
{%- assign goal = 50.0 -%}
{%- assign bg_color = "#000000" -%}
{%- assign text_color = "#FFFFFF" -%}
{%- assign progress_color = "#22C55E" -%}
{%- assign success_msg = "Congratulations! You've unlocked FREE shipping" -%}
{%- assign progress_msg = "Only $10.00 away from free shipping!" -%}
{%- assign position = "top" -%}
{%- assign animation = "none" -%}

{%- if settings_json -%}
  {%- assign goal = settings_json.goalAmount | default: 50.0 -%}
  {%- assign bg_color = settings_json.backgroundColor | default: "#000000" -%}
  {%- assign text_color = settings_json.textColor | default: "#FFFFFF" -%}
  {%- assign progress_color = settings_json.progressBarColor | default: "#22C55E" -%}
  {%- assign success_msg = settings_json.successMessage | default: "Congratulations! You've unlocked FREE shipping" -%}
  {%- assign progress_msg = settings_json.progressMessage | default: "Only $10.00 away from free shipping!" -%}
  {%- assign position = settings_json.position | default: "top" -%}
  {%- assign animation = settings_json.animation | default: "none" -%}
{%- endif -%}

{%- if settings_json and settings_json.isActive == true -%}
<style>
.freeship-pro-bar {
  background: var(--fs-bg);
  color: var(--fs-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  z-index: 2147483647;
  transition: opacity 0.4s ease;
  width: 100%;
  box-sizing: border-box;
}

.freeship-pro-bar.freeship-position-top {
  position: fixed;
  top: 0;
  left: 0;
}

.freeship-pro-bar.freeship-position-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
}

.freeship-pro-container {
  max-width: 800px;
  margin: 0 auto;
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.freeship-pro-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
}

.freeship-pro-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.freeship-pro-msg {
  font-size: 15px;
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
}

.freeship-pro-msg strong {
  font-weight: 800;
}

.freeship-pro-progress-wrapper {
  width: 100%;
  height: 8px;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 9999px;
  overflow: hidden;
}

.freeship-pro-progress-bar {
  height: 100%;
  background: var(--fs-progress);
  border-radius: 9999px;
  width: 0%;
  transition: width 0.5s ease-out;
}

/* Premium Animations */
@keyframes fs-fill-luxury {
  0% { width: 0%; opacity: 0; }
  10% { opacity: 1; }
  40% { width: 65%; }
  85% { width: 65%; opacity: 1; }
  100% { width: 65%; opacity: 0; }
}

@keyframes fs-fill-neon {
  0% { width: 0%; box-shadow: 0 0 0px #39ff14; opacity: 0; }
  15% { opacity: 1; box-shadow: 0 0 8px #39ff14; }
  45% { width: 65%; box-shadow: 0 0 16px #39ff14; }
  85% { width: 65%; box-shadow: 0 0 8px #39ff14; opacity: 1; }
  100% { width: 65%; opacity: 0; }
}

@keyframes fs-fill-urgency {
  0% { width: 0%; opacity: 0; }
  5% { opacity: 1; }
  25% { width: 65%; }
  85% { width: 65%; opacity: 1; }
  100% { width: 65%; opacity: 0; }
}

@keyframes fs-fill-summer {
  0% { width: 0%; opacity: 0; }
  15% { opacity: 1; }
  50% { width: 65%; }
  85% { width: 65%; opacity: 1; }
  100% { width: 65%; opacity: 0; }
}

@keyframes fs-stripes-move {
  0% { background-position: 0 0; }
  100% { background-position: 20px 0; }
}
</style>

<div id="freeship-pro-bar" 
     class="freeship-pro-bar freeship-position-{{ position }}"
     data-goal="{{ goal }}" 
     data-success-msg="{{ success_msg }}" 
     data-progress-msg="{{ progress_msg }}"
     data-position="{{ position }}"
     style="--fs-bg: {{ bg_color }}; --fs-text: {{ text_color }}; --fs-progress: {{ progress_color }};">
  <div class="freeship-pro-container">
    <div class="freeship-pro-content">
      <div class="freeship-pro-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div id="freeship-pro-msg" class="freeship-pro-msg">Loading free shipping...</div>
    </div>
    <div class="freeship-pro-progress-wrapper">
      <div id="freeship-pro-progress" class="freeship-pro-progress-bar" style="{% if animation != 'none' %}animation: fs-fill-{{ animation }} 3s infinite;{% endif %}"></div>
    </div>
  </div>
</div>

<script>
(function() {
  const initFreeshipBar = () => {
    const bar = document.getElementById('freeship-pro-bar');
    if (!bar) return;

    const msgEl = document.getElementById('freeship-pro-msg');
    const progressEl = document.getElementById('freeship-pro-progress');

    const goal = parseFloat(bar.getAttribute('data-goal')) || 50;
    const successMsg = bar.getAttribute('data-success-msg');
    const progressMsg = bar.getAttribute('data-progress-msg') || 'Add $10.00 more to unlock FREE shipping';
    const position = bar.getAttribute('data-position');

    if (position === 'top') {
      document.body.style.paddingTop = bar.offsetHeight + 'px';
    } else if (position === 'bottom') {
      document.body.style.paddingBottom = bar.offsetHeight + 'px';
    }

    const updateBar = (cartTotalCents) => {
      const totalDollars = cartTotalCents / 100;
      const remainingDollars = goal - totalDollars;

      if (remainingDollars > 0) {
        const formattedAmount = remainingDollars.toFixed(2);
        msgEl.innerHTML = progressMsg.replace(/\$10\.00/g, `<strong>$${formattedAmount}</strong>`);
        const percentage = Math.min((totalDollars / goal) * 100, 100);
        progressEl.style.width = `${percentage}%`;
      } else {
        msgEl.innerHTML = successMsg;
        progressEl.style.width = '100%';
      }
    };

    const fetchCart = () => {
      fetch('/cart.js', { cache: 'no-store' })
        .then(response => response.json())
        .then(cart => {
          updateBar(cart.total_price);
        })
        .catch(err => console.error("Error fetching cart", err));
    };

    fetchCart();

    const originalFetch = window.fetch;
    window.fetch = async (...args) => {
      const response = await originalFetch(...args);
      const url = typeof args[0] === 'string' ? args[0] : args[0]?.url;
      if (url && (url.includes('/cart/add') || url.includes('/cart/change') || url.includes('/cart/clear') || url.includes('/cart/update'))) {
        response.clone().text().then(() => {
          setTimeout(fetchCart, 100);
        }).catch(e => console.error(e));
      }
      return response;
    };

    const originalXHR = window.XMLHttpRequest.prototype.open;
    window.XMLHttpRequest.prototype.open = function(method, url) {
      this.addEventListener('load', function() {
        if (url && (url.includes('/cart/add') || url.includes('/cart/change') || url.includes('/cart/clear') || url.includes('/cart/update'))) {
          setTimeout(fetchCart, 100);
        }
      });
      originalXHR.apply(this, arguments);
    };
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFreeshipBar);
  } else {
    initFreeshipBar();
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "FreeShip Pro Bar",
  "target": "body",
  "settings": []
}
{% endschema %}
