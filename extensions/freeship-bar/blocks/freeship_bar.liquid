{%- assign settings_json = shop.metafields.freeship.settings.value -%}
{%- assign goal = 50.0 -%}
{%- assign bg_color = "#000000" -%}
{%- assign text_color = "#FFFFFF" -%}
{%- assign progress_color = "#22C55E" -%}
{%- assign success_msg = "Congratulations! You've unlocked FREE shipping" -%}
{%- assign progress_msg = "Only $10.00 away from free shipping!" -%}
{%- assign position = "top" -%}
{%- assign animation = "none" -%}

{%- if settings_json -%}
  {%- assign goal = settings_json.goalAmount | default: 50.0 -%}
  {%- assign bg_color = settings_json.backgroundColor | default: "#000000" -%}
  {%- assign text_color = settings_json.textColor | default: "#FFFFFF" -%}
  {%- assign progress_color = settings_json.progressBarColor | default: "#22C55E" -%}
  {%- assign success_msg = settings_json.successMessage | default: "Congratulations! You've unlocked FREE shipping" -%}
  {%- assign progress_msg = settings_json.progressMessage | default: "Only $10.00 away from free shipping!" -%}
  {%- assign position = settings_json.position | default: "top" -%}
  {%- assign animation = settings_json.animation | default: "none" -%}
{%- endif -%}

<div id="freeship-pro-bar" 
     class="freeship-pro-bar freeship-position-{{ position }}"
     data-goal="{{ goal }}" 
     data-success-msg="{{ success_msg }}" 
     data-progress-msg="{{ progress_msg }}"
     data-position="{{ position }}"
     style="--fs-bg: {{ bg_color }}; --fs-text: {{ text_color }}; --fs-progress: {{ progress_color }};">
  <div class="freeship-pro-container">
    <div class="freeship-pro-content">
      <div class="freeship-pro-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div id="freeship-pro-msg" class="freeship-pro-msg">Loading free shipping...</div>
    </div>
    <div class="freeship-pro-progress-wrapper">
      <div id="freeship-pro-progress" class="freeship-pro-progress-bar" style="{% if animation != 'none' %}animation: fs-fill-{{ animation }} 3s infinite;{% endif %}"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FreeShip Pro Bar",
  "target": "body",
  "javascript": "freeship.js",
  "stylesheet": "freeship.css",
  "settings": []
}
{% endschema %}
