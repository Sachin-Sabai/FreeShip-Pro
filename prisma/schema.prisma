// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id              String      @id // shop domain (e.g., example.myshopify.com)
  plan            String      @default("STARTER") // STARTER, BASIC, PRO, PREMIUM, ENTERPRISE
  billingId       String?     // Shopify Subscription ID
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  campaigns       Campaign[]
  metrics         DailyMetric[]
}

model Campaign {
  id              String      @id @default(uuid())
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String
  isActive        Boolean     @default(false)
  
  // Rules & Targeting
  goalAmount      Float
  targetCountries String?     // JSON array of country codes
  targetDevices   String?     // ALL, DESKTOP, MOBILE
  
  // Design & Template
  templateId      String      @default("minimal")
  config          String      // JSON containing colors, animations, texts
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model DailyMetric {
  id              String      @id @default(uuid())
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date            DateTime    
  
  // Real Analytics Tracking
  views           Int         @default(0)
  clicks          Int         @default(0)
  ordersInfluenced Int        @default(0)
  revenueGenerated Float      @default(0)
  
  @@unique([shopId, date])
}
